# MongoDB: the `platform` database (tenants, users) and one database per tenant live here.
MONGODB_URI=mongodb://localhost:27017
PLATFORM_DB=platform
TENANT_DB_PREFIX=tenant_

# Encrypts tenants' GitHub tokens at rest. Create one: sourcer-admin generate-key
SECRETS_KEY=

# Shared secret between the Next.js server and this API. Use a long random string.
API_SERVICE_KEY=

# CLI convenience: default company for `sourcer` commands.
SOURCER_TENANT=

# Fallback GitHub token for CLI use when a tenant has none stored.
GITHUB_TOKEN=
